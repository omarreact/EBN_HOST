# Enable only after provider permission for direct in-app playback is established.
CINEPLEX_PLAYBACK_AUTHORIZED=false
# Mature categories require provider/hosting policy confirmation.
PINFLIX_MATURE_ENABLED=false
# No TMDB API key is required. Server-side media transport needs
# explicitly authorized sources and incurs Vercel Function usage.
# Do not enable PINFLIX_TEST_MEDIA on production deployments.
